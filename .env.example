# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-at-least-32-random-characters
# Set to false only for a local test without HTTPS
COOKIE_SECURE=true
# Address the app listens on; keep 127.0.0.1 when a reverse proxy on the same host terminates TLS
BIND_ADDR=127.0.0.1
# Java sandbox size. Defaults suit a 2-vCPU server; for a full class on a 4-vCPU server use 4 / 4.0 / 2g / 512
RUNNER_WORKERS=2
RUNNER_CPUS=2.0
RUNNER_MEM=1g
RUNNER_PIDS=256
